@page
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <h1 class="h3 mb-1">Forgot your password?</h1>
            <p class="text-muted">
                Self-service password reset isn't wired up yet &mdash; it needs an email sender, which is
                planned for a later sprint.
            </p>
            <p class="text-muted mb-4">
                For now, double-check your email and password, or register a new account if this one isn't
                yours to recover.
            </p>

            <a class="btn btn-primary w-100" asp-page="/Account/Login">Back to log in</a>
            <p class="mt-3 mb-0">
                Need an account instead?
                <a asp-page="/Account/Register">Register</a>
            </p>
        </div>
    </div>
</div>
