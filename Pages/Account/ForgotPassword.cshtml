@page
@model TimeManagement.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            @if (Model.EmailSent)
            {
                <h1 class="h3 mb-1">Check your email</h1>
                <p class="text-muted mb-4">If that email is registered, a reset link has been sent.</p>
                <a class="btn btn-primary w-100" asp-page="/Account/Login">Back to log in</a>
            }
            else
            {
                <h1 class="h3 mb-1">Forgot your password?</h1>
                <p class="text-muted mb-4">Enter your email and we'll send you a link to reset your password.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                </form>

                <p class="mt-3 mb-0">
                    <a asp-page="/Account/Login">Back to log in</a>
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
