@page
@model TimeManagement.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            @if (Model.IsComplete)
            {
                <h1 class="h3 mb-1">Password reset</h1>
                <p class="text-muted mb-4">Your password has been changed. You can now log in with your new password.</p>
                <a class="btn btn-primary w-100" asp-page="/Account/Login">Go to log in</a>
            }
            else if (Model.IsLinkInvalid)
            {
                <h1 class="h3 mb-1">This link isn't valid</h1>
                <p class="text-muted mb-4">
                    This password reset link is invalid or has expired. Reset links only work for a
                    limited time after they're sent - request a new one below.
                </p>
                <a class="btn btn-primary w-100" asp-page="/Account/ForgotPassword">Request a new link</a>
            }
            else
            {
                <h1 class="h3 mb-1">Reset your password</h1>
                <p class="text-muted mb-4">Choose a new password for your account.</p>

                <form method="post">
                    <input type="hidden" asp-for="Input.UserId" />
                    <input type="hidden" asp-for="Input.Token" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" autofocus />
                        <div class="form-text">
                            At least 8 characters, including an uppercase letter, a lowercase letter and a number.
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Reset password</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
