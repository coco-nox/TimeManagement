@page
@model TimeManagement.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Course";
}

<h1 class="h3 mb-1">Course</h1>
<p class="text-muted">Create course folders, upload assessment files, and track progress on each one.</p>

@if (Model.StatusMessage != null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card text-center mb-3">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">@Model.TotalAssessmentsTracked</div>
                <div class="small text-muted text-uppercase">Assessments tracked</div>
            </div>
        </div>

        <div class="small text-muted text-uppercase fw-semibold mb-2">Your courses</div>

        @if (Model.Courses.Any())
        {
            <div class="list-group mb-3">
                @foreach (var course in Model.Courses)
                {
                    var docCount = course.Assessments.Sum(a => a.Documents.Count);
                    <a asp-page="/Courses/Index" asp-route-courseId="@course.Id" asp-route-tab="@Model.ActiveTab"
                       class="list-group-item list-group-item-action @(Model.SelectedCourseId == course.Id ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <span style="width: 0.7rem; height: 0.7rem; border-radius: 50%; background-color: @course.ColourHex; flex-shrink: 0;"></span>
                            <div class="fw-semibold">@course.Title</div>
                        </div>
                        <div class="small @(Model.SelectedCourseId == course.Id ? "" : "text-muted")">@docCount document@(docCount == 1 ? "" : "s")</div>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-3">You haven't added any courses yet.</p>
        }

        <form method="post" asp-page-handler="CreateCourse" class="d-flex gap-2">
            <label asp-for="Input.Title" class="visually-hidden"></label>
            <input asp-for="Input.Title" class="form-control form-control-sm" placeholder="New course name" />
            <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Add</button>
        </form>
        <span asp-validation-for="Input.Title" class="text-danger small"></span>
    </div>

    <div class="col-lg-9">
        @if (Model.SelectedCourse != null)
        {
            var course = Model.SelectedCourse;

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 0.8rem; height: 0.8rem; border-radius: 50%; background-color: @course.ColourHex; flex-shrink: 0;"></span>
                    <span class="fw-semibold fs-5">@course.Title</span>
                </div>
                @* data-course-title (not string interpolation into onsubmit) is
                   deliberate: a course title containing an apostrophe would break
                   out of an inline JS string literal even though Razor HTML-encodes
                   it - the browser decodes that back to a raw ' before the script
                   runs. Reading it via the DOM in deleteCourseForm.js sidesteps
                   that entirely. *@
                <form method="post" asp-page-handler="DeleteCourse" asp-route-courseId="@course.Id"
                      class="delete-course-form" data-course-title="@course.Title">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete course</button>
                </form>
            </div>

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a asp-page="/Courses/Index" asp-route-courseId="@course.Id" asp-route-tab="upload"
                       class="nav-link @(Model.ActiveTab == "upload" ? "active" : "")">Upload</a>
                </li>
                <li class="nav-item">
                    @* Labelled "Manage" (not "Preferences") even though the tab/route value
                       stays "preferences" internally - the Calendar page has its own,
                       unrelated "Preferences" tab (study hours/days), and using the same
                       label for two different things on two different pages was confusing. *@
                    <a asp-page="/Courses/Index" asp-route-courseId="@course.Id" asp-route-tab="preferences"
                       class="nav-link @(Model.ActiveTab == "preferences" ? "active" : "")">Manage</a>
                </li>
                <li class="nav-item">
                    <a asp-page="/Courses/Index" asp-route-courseId="@course.Id" asp-route-tab="completed"
                       class="nav-link @(Model.ActiveTab == "completed" ? "active" : "")">Completed</a>
                </li>
            </ul>

            @if (Model.ActiveTab == "preferences")
            {
                <div class="card">
                    <div class="card-body">
                        <div class="fw-semibold mb-1">Manage assessments</div>
                        <p class="text-muted small">Change an assessment's category, set its due date, or remove one entirely.</p>

                        @if (!course.Assessments.Any())
                        {
                            <p class="text-muted mb-0">No assessments uploaded yet.</p>
                        }
                        else
                        {
                            var assessments = course.Assessments
                                .OrderBy(a => a.Title)
                                .ToList();

                            <div class="list-group list-group-flush">
                                @foreach (var assessment in assessments)
                                {
                                    <div class="list-group-item px-0 py-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="fw-semibold">
                                                @assessment.Title
                                                <span class="badge text-bg-light text-uppercase ms-1">@assessment.Category</span>
                                            </div>

                                            <form method="post" asp-page-handler="UpdateAssessmentCategory" asp-route-courseId="@course.Id" asp-route-assessmentId="@assessment.Id" class="d-flex align-items-center gap-2">
                                                <label for="category-@assessment.Id" class="small text-muted mb-0">Type</label>
                                                <select id="category-@assessment.Id" name="category" class="form-select form-select-sm w-auto">
                                                    @foreach (var option in Enum.GetValues<AssessmentCategory>())
                                                    {
                                                        <option value="@option" selected="@(assessment.Category == option ? "selected" : null)">@option</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Move</button>
                                            </form>
                                        </div>

                                        <div class="small text-muted mt-1">
                                            @if (assessment.DueDate.HasValue)
                                            {
                                                <span>Due @assessment.DueDate.Value.ToString("d MMM yyyy")</span>
                                            }
                                            else if (assessment.Category == AssessmentCategory.Coursework)
                                            {
                                                <span>No fixed due date</span>
                                            }
                                            else
                                            {
                                                <span>No due date detected from the uploaded document</span>
                                            }
                                        </div>

                                        <div class="d-flex flex-wrap align-items-start gap-2 mt-2">
                                            @* Zero-JS disclosure, same pattern as the Dashboard's folder-colour
                                               picker - no due date editing needed until this is opened. *@
                                            <details class="due-date-editor">
                                                <summary class="btn btn-outline-secondary btn-sm">@(assessment.DueDate.HasValue ? "Edit due date" : "Set due date")</summary>
                                                <form method="post" asp-page-handler="UpdateAssessmentDueDate" asp-route-courseId="@course.Id" asp-route-assessmentId="@assessment.Id" class="d-flex align-items-center gap-2 mt-2">
                                                    <label for="dueDate-@assessment.Id" class="visually-hidden">Due date</label>
                                                    <input type="date" id="dueDate-@assessment.Id" name="dueDate" class="form-control form-control-sm w-auto" value="@(assessment.DueDate?.ToString("yyyy-MM-dd"))" />
                                                    <button type="submit" class="btn btn-primary btn-sm">Save date</button>
                                                </form>
                                            </details>

                                            <form method="post" asp-page-handler="DeleteAssessment" asp-route-courseId="@course.Id" asp-route-assessmentId="@assessment.Id"
                                                  onsubmit="return confirm('Delete this assessment and all @assessment.Documents.Count document(s) attached to it? This can\'t be undone.');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete assessment</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.ActiveTab == "completed")
            {
                var completedAssessments = course.Assessments
                    .Where(a => a.IsCompleted)
                    .OrderByDescending(a => a.CompletedUtc)
                    .ToList();

                <div class="card">
                    @* The same colour strip used for a course's folder card on the
                       Dashboard - this tab is literally that course's "completed"
                       folder, so it gets the same visual device. *@
                    <div class="folder-card-strip" style="--folder-colour: @course.ColourHex"></div>
                    <div class="card-body">
                        <div class="fw-semibold mb-1">@course.Title &mdash; Completed</div>
                        <p class="text-muted small">Assessments you've marked complete, kept out of the way here instead of crowding the Upload tab.</p>

                        @if (!completedAssessments.Any())
                        {
                            <p class="text-muted mb-0">Nothing completed yet. Mark an assessment complete from the Upload tab and it'll move here.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var assessment in completedAssessments)
                                {
                                    <div class="list-group-item px-0 py-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="fw-semibold">
                                                @assessment.Title
                                                <span class="badge text-bg-light text-uppercase ms-1">@assessment.Category</span>
                                            </div>
                                            <span class="badge text-bg-success">Completed @assessment.CompletedUtc?.ToString("d MMM yyyy")</span>
                                        </div>

                                        @{
                                            var completedTutorTab = assessment.Category switch
                                            {
                                                AssessmentCategory.Report => "report",
                                                AssessmentCategory.Quiz or AssessmentCategory.Test => "quiz",
                                                _ => "chat"
                                            };
                                        }
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                            <form method="post" asp-page-handler="ToggleAssessmentComplete" asp-route-courseId="@course.Id" asp-route-assessmentId="@assessment.Id">
                                                <input type="hidden" name="returnTab" value="completed" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Mark incomplete</button>
                                            </form>

                                            <a asp-page="/Tutor/Index" asp-route-courseId="@course.Id" asp-route-tab="@completedTutorTab" asp-route-assessmentId="@assessment.Id"
                                               class="btn btn-outline-secondary btn-sm">Ask tutor about this</a>
                                        </div>

                                        <details class="mt-2">
                                            <summary class="small text-muted" style="cursor: pointer;">Documents (@assessment.Documents.Count)</summary>

                                            @if (assessment.Documents.Any())
                                            {
                                                <ul class="list-group list-group-flush mt-2">
                                                    @foreach (var document in assessment.Documents.OrderByDescending(d => d.UploadedUtc))
                                                    {
                                                        <li class="list-group-item px-0">
                                                            <div class="d-flex justify-content-between align-items-center gap-3">
                                                                <div>
                                                                    <div class="small fw-semibold">@document.OriginalFileName</div>
                                                                    <div class="small text-muted">
                                                                        Uploaded @document.UploadedUtc.ToString("d MMM yyyy")
                                                                        @if (string.IsNullOrEmpty(document.ExtractedText))
                                                                        {
                                                                            <span>&middot; text not extracted</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <form method="post" asp-page-handler="DeleteDocument" asp-route-courseId="@course.Id" asp-route-documentId="@document.Id"
                                                                      onsubmit="return confirm('Delete this document?');">
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <div class="mt-2 small text-muted">No documents uploaded for this assessment yet.</div>
                                            }
                                        </details>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="small text-muted text-uppercase fw-semibold mb-2">Upload a document</div>
                        @* Auto-detect (the default) lets the category come from the file's own
                           text - useful when uploading several documents without knowing each
                           one's exact type up front. Picking a specific type here overrides
                           that. Either way this decides which on-disk subfolder the file ends
                           up in (see GetCategoryFolder in the code-behind); the due date is
                           always detected automatically from the file's text where possible. *@
                        <form method="post" asp-page-handler="Upload" asp-route-courseId="@course.Id" enctype="multipart/form-data" class="row g-2 align-items-center">
                            <div class="col">
                                <label for="uploadFile" class="visually-hidden">Choose file</label>
                                <input type="file" id="uploadFile" name="UploadedFile" class="form-control" accept=".pdf,.docx" />
                            </div>
                            <div class="col-auto">
                                <label for="uploadCategory" class="visually-hidden">Assessment type</label>
                                <select id="uploadCategory" name="UploadCategory" class="form-select">
                                    <option value="">Auto-detect</option>
                                    @foreach (var category in Enum.GetValues<AssessmentCategory>())
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">Upload</button>
                            </div>
                        </form>
                        <p class="text-muted small mt-2 mb-0">PDF and Word (.docx) files, up to 20 MB. Leave the type on "Auto-detect" to have it guessed from the document's text.</p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="fw-semibold">Uploaded documents</div>
                        <p class="text-muted small">
                            Progress here tracks time remaining until the due date — a stand-in until real
                            checklists (reports) and quiz results (tests) are built. Assessments marked
                            complete move to the Completed tab instead of staying listed here.
                        </p>
                        @if (course.Assessments.Any(a => a.Category != AssessmentCategory.Coursework))
                        {
                            <p class="text-muted small">Got due dates set here? <a asp-page="/Calendar/Index">Set up your Calendar</a> to get an AI-generated study schedule built around them.</p>
                        }

                        @{
                            var uploadAssessments = course.Assessments.Where(a => !a.IsCompleted).ToList();
                        }

                        @if (!uploadAssessments.Any())
                        {
                            if (course.Assessments.Any())
                            {
                                <p class="text-muted mb-0">Everything here has been marked complete - see the Completed tab.</p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No assessments uploaded yet.</p>
                            }
                        }
                        else
                        {
                            var assessments = uploadAssessments
                                .OrderBy(a => a.DueDate ?? DateTime.MaxValue)
                                .ThenBy(a => a.Title)
                                .ToList();

                            <div class="list-group list-group-flush">
                                @foreach (var assessment in assessments)
                                {
                                    var progress = Model.GetProgress(assessment);
                                    // Available any time, not just once overdue - a student who
                                    // finishes early shouldn't have to wait for the due date to
                                    // pass before the Dashboard progress bar gives them credit.
                                    var canToggleComplete = assessment.Category != AssessmentCategory.Coursework;

                                    <div class="list-group-item px-0 py-3">
                                        <div class="fw-semibold">
                                            @assessment.Title
                                            <span class="badge text-bg-light text-uppercase ms-1">@assessment.Category</span>
                                        </div>
                                        <div class="small text-muted">
                                            @if (assessment.DueDate.HasValue)
                                            {
                                                <span>Due @assessment.DueDate.Value.ToString("d MMM yyyy")</span>
                                            }
                                            else if (assessment.Category == AssessmentCategory.Coursework)
                                            {
                                                <span>No fixed due date</span>
                                            }
                                            else
                                            {
                                                <span>No due date detected</span>
                                            }
                                        </div>

                                        @if (progress.Percent.HasValue)
                                        {
                                            <div class="d-flex align-items-center gap-2 mt-2">
                                                <div class="progress flex-grow-1" style="height: 0.5rem;">
                                                    <div class="progress-bar @progress.BarClass" style="width: @(progress.Percent)%"></div>
                                                </div>
                                                <span class="small text-muted text-nowrap">@progress.Label</span>
                                            </div>
                                        }
                                        else if (assessment.Category != AssessmentCategory.Coursework)
                                        {
                                            <div class="mt-2 alert alert-warning py-2 px-3 mb-0" role="alert">
                                                @progress.Label — update as soon as possible.
                                            </div>
                                        }

                                        @{
                                            // Chat has no assessment-specific view, so Coursework (which only
                                            // ever uses Chat) just opens the course's chat generally rather than
                                            // trying to "select" itself on a tab that doesn't take a selection.
                                            var tutorTab = assessment.Category switch
                                            {
                                                AssessmentCategory.Report => "report",
                                                AssessmentCategory.Quiz or AssessmentCategory.Test => "quiz",
                                                _ => "chat"
                                            };
                                        }
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                            @* No IsCompleted branch needed here - uploadAssessments above already
                                               excludes completed ones, which move to the Completed tab instead. *@
                                            @if (canToggleComplete)
                                            {
                                                <form method="post" asp-page-handler="ToggleAssessmentComplete" asp-route-courseId="@course.Id" asp-route-assessmentId="@assessment.Id">
                                                    <button type="submit" class="btn btn-success btn-sm">Mark complete</button>
                                                </form>
                                            }

                                            <a asp-page="/Tutor/Index" asp-route-courseId="@course.Id" asp-route-tab="@tutorTab" asp-route-assessmentId="@assessment.Id"
                                               class="btn btn-outline-secondary btn-sm">Ask tutor about this</a>
                                        </div>

                                        <details class="mt-2">
                                            <summary class="small text-muted" style="cursor: pointer;">Documents (@assessment.Documents.Count)</summary>

                                            @if (assessment.Documents.Any())
                                            {
                                                <ul class="list-group list-group-flush mt-2">
                                                    @foreach (var document in assessment.Documents.OrderByDescending(d => d.UploadedUtc))
                                                    {
                                                        <li class="list-group-item px-0">
                                                            <div class="d-flex justify-content-between align-items-center gap-3">
                                                                <div>
                                                                    <div class="small fw-semibold">@document.OriginalFileName</div>
                                                                    <div class="small text-muted">
                                                                        Uploaded @document.UploadedUtc.ToString("d MMM yyyy")
                                                                        @if (string.IsNullOrEmpty(document.ExtractedText))
                                                                        {
                                                                            <span>&middot; text not extracted</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <form method="post" asp-page-handler="DeleteDocument" asp-route-courseId="@course.Id" asp-route-documentId="@document.Id"
                                                                      onsubmit="return confirm('Delete this document?');">
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <div class="mt-2 small text-muted">No documents uploaded for this assessment yet.</div>
                                            }
                                        </details>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (Model.Courses.Any())
        {
            <p class="text-muted">Choose a course from the list, or add a new one, to manage its documents.</p>
        }
        else
        {
            <p class="text-muted">Add your first course using the panel on the left, then upload documents to it.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Named per course via data-course-title (see the comment above the
            // form in the markup) rather than an inline onsubmit string, so a
            // title containing an apostrophe can't break the confirmation.
            document.querySelectorAll('.delete-course-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    var title = form.getAttribute('data-course-title') || 'this course';
                    if (!confirm('Delete "' + title + '" and everything in it - every assessment and document? This can\'t be undone.')) {
                        event.preventDefault();
                    }
                });
            });
        })();
    </script>
}
