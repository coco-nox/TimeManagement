@* Renders the right-hand side of the navbar: account links when signed
   out, or the user's name plus settings/logout when signed in. *@
@using Microsoft.AspNetCore.Identity
@using TimeManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <li class="nav-item">
        <span class="nav-link text-dark">Hi, @(currentUser?.FullName ?? User.Identity?.Name)</span>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Settings">Settings</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Account/Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark border-0">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Account/Login">Log in</a>
    </li>
}
</ul>
