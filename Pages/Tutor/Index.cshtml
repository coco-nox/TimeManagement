@page
@model TimeManagement.Pages.Tutor.IndexModel
@{
    ViewData["Title"] = "Tutor";
}

<h1 class="h3 mb-1">Tutor</h1>
<p class="text-muted">Ask questions about your course material, or test yourself with a generated quiz.</p>

@* Quiz & test and Report are a future sprint - shown so the plan is visible, not clickable yet. *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <span class="nav-link active">Chat</span>
    </li>
    <li class="nav-item">
        <span class="nav-link disabled" aria-disabled="true" title="Coming soon">Quiz &amp; test</span>
    </li>
    <li class="nav-item">
        <span class="nav-link disabled" aria-disabled="true" title="Coming soon">Report</span>
    </li>
</ul>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card text-center mb-3">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">@Model.TotalAssessmentsTracked</div>
                <div class="small text-muted text-uppercase">Assessments tracked</div>
            </div>
        </div>

        <div class="small text-muted text-uppercase fw-semibold mb-2">Your courses</div>

        @if (!Model.Courses.Any())
        {
            <p class="text-muted small">You don't have any courses yet. <a asp-page="/Courses/Index">Add one</a> before using the tutor.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var course in Model.Courses)
                {
                    var docCount = course.Assessments.Sum(a => a.Documents.Count);
                    <a asp-page="/Tutor/Index" asp-route-courseId="@course.Id"
                       class="list-group-item list-group-item-action @(Model.SelectedCourseId == course.Id ? "active" : "")">
                        <div class="fw-semibold">@course.Title</div>
                        <div class="small @(Model.SelectedCourseId == course.Id ? "" : "text-muted")">@docCount document@(docCount == 1 ? "" : "s")</div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="col-lg-9">
        @if (Model.Courses.Any() && Model.SelectedCourseId == null)
        {
            <p class="text-muted">Choose a course from the list to start asking questions about its documents.</p>
        }
        else if (Model.SelectedCourse != null)
        {
            var totalDocs = Model.SelectedCourse.Assessments.Sum(a => a.Documents.Count);
            <div class="card">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-semibold">@Model.SelectedCourse.Title</span>
                        <span class="text-muted"> — based on your @totalDocs uploaded document@(totalDocs == 1 ? "" : "s")</span>
                    </div>

                    @* Nothing to archive/restart in a brand new, empty conversation. *@
                    @if (Model.ChatHistory.Any())
                    {
                        <div class="d-flex gap-2">
                            <form method="post" asp-page-handler="ArchiveConversation" asp-route-courseId="@Model.SelectedCourseId"
                                  onsubmit="return confirm('Archive this conversation and start a new one? The old messages are kept, just hidden from view.');">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Archive &amp; start new</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteConversation" asp-route-courseId="@Model.SelectedCourseId"
                                  onsubmit="return confirm('Delete this conversation? This can\'t be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete conversation</button>
                            </form>
                        </div>
                    }
                </div>

                <div id="chatWindow" class="p-3" style="height: 420px; overflow-y: auto;">
                    @if (!Model.ChatHistory.Any())
                    {
                        <p class="text-muted small mb-0" id="chatEmptyState">Ask a question about this course's documents to get started.</p>
                    }
                    else
                    {
                        foreach (var message in Model.ChatHistory)
                        {
                            if (message.Role == "assistant")
                            {
                                <div class="d-flex justify-content-start mb-2">
                                    <div class="bg-light rounded p-2" style="max-width: 75%;">
                                        <div>@message.Content</div>
                                        @if (!string.IsNullOrWhiteSpace(message.SourceDocument))
                                        {
                                            <div class="small text-muted mt-1">Source: @message.SourceDocument</div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-end mb-2">
                                    <div class="bg-primary text-white rounded p-2" style="max-width: 75%;">@message.Content</div>
                                </div>
                            }
                        }
                    }
                </div>

                <div class="p-3 border-top">
                    <form id="chatForm" class="d-flex gap-2" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.SelectedCourseId" />
                        <label for="chatQuestion" class="visually-hidden">Question</label>
                        <input type="text" name="question" id="chatQuestion" class="form-control" placeholder="Ask a question about @Model.SelectedCourse.Title..." required />
                        <button type="submit" class="btn btn-primary" id="chatSendButton">Send</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@* Dots use the app's accent colour (same var palettes.css drives every
   theme from) so the indicator matches whichever palette is active. *@
<style>
    .typing-dots span {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 4px;
        border-radius: 50%;
        background-color: var(--accent);
        opacity: 0.3;
        animation: typing-pulse 1.4s ease-in-out infinite both;
    }

    .typing-dots span:last-child {
        margin-right: 0;
    }

    .typing-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes typing-pulse {
        0%, 80%, 100% {
            opacity: 0.3;
            transform: scale(0.8);
        }

        40% {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var chatForm = document.getElementById('chatForm');
            if (!chatForm) {
                return;
            }

            var chatWindow = document.getElementById('chatWindow');
            var sendButton = document.getElementById('chatSendButton');
            var questionInput = document.getElementById('chatQuestion');
            var emptyState = document.getElementById('chatEmptyState');

            // Creates an empty bubble and appends it, returning the bubble
            // element itself so its content can be filled in now (appendMessage)
            // or later (the "Thinking..." placeholder, filled in once the
            // response arrives instead of getting a second bubble appended).
            function appendRow(role) {
                if (emptyState) {
                    emptyState.remove();
                    emptyState = null;
                }

                var row = document.createElement('div');
                row.className = 'd-flex mb-2 ' + (role === 'assistant' ? 'justify-content-start' : 'justify-content-end');

                var bubble = document.createElement('div');
                bubble.className = (role === 'assistant' ? 'bg-light' : 'bg-primary text-white') + ' rounded p-2';
                bubble.style.maxWidth = '75%';

                row.appendChild(bubble);
                chatWindow.appendChild(row);
                chatWindow.scrollTop = chatWindow.scrollHeight;

                return bubble;
            }

            function setBubbleContent(bubble, content, source) {
                bubble.innerHTML = '';

                var text = document.createElement('div');
                text.textContent = content;
                bubble.appendChild(text);

                if (source) {
                    var sourceLine = document.createElement('div');
                    sourceLine.className = 'small text-muted mt-1';
                    sourceLine.textContent = 'Source: ' + source;
                    bubble.appendChild(sourceLine);
                }

                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            function appendMessage(role, content, source) {
                setBubbleContent(appendRow(role), content, source);
            }

            function appendThinkingBubble() {
                var bubble = appendRow('assistant');

                var dots = document.createElement('div');
                dots.className = 'typing-dots';
                dots.innerHTML = '<span></span><span></span><span></span>';
                bubble.appendChild(dots);

                chatWindow.scrollTop = chatWindow.scrollHeight;
                return bubble;
            }

            chatForm.addEventListener('submit', function (event) {
                event.preventDefault();

                var question = questionInput.value.trim();
                if (!question) {
                    return;
                }

                appendMessage('user', question, null);
                var formData = new FormData(chatForm);
                questionInput.value = '';
                sendButton.disabled = true;

                // Shown the instant Send is clicked, not once the response
                // arrives - the same bubble is then filled in below rather
                // than a second one being appended underneath it.
                var thinkingBubble = appendThinkingBubble();

                fetch(window.location.pathname + '?handler=Ask', {
                    method: 'POST',
                    body: formData
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Request failed with status ' + response.status);
                        }
                        return response.json();
                    })
                    .then(function (result) {
                        setBubbleContent(thinkingBubble, result.answer, result.sourceDocument);
                    })
                    .catch(function () {
                        setBubbleContent(thinkingBubble, "Something went wrong sending that question. Please try again.", null);
                    })
                    .finally(function () {
                        sendButton.disabled = false;
                        questionInput.focus();
                    });
            });
        })();
    </script>
}
